    {
      "parameters": {
        "jsCode": "const cases = $input.all().map(item => item.json)\nconst customer_data = $(\"Split Customer Requests\").all().map(item=> item.json)\n\nreturn cases.map((item, index) => {\n  const customer = customer_data.find(customer =>  customer.customer_gmail === item.gmail)\n  return {\n    json:{\n      customer_id : item.customer_id,\n      ...customer,\n      case_id : `CASE_${Date.now()}_${index + 1}`,\n      idempotency_key : `${item.gmail}|${customer.customer_message}`\n    }\n  }\n}); "
      },
