    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json)\nreturn items.map(item => {\n  const error = (\n                typeof item.error === \"string\"\n                ? item.error\n                : item.error?.message ||\n                 item.error?.description ||\n                \"\").toLowerCase()\n  let retryable\n  let error_type\n  if (\n      error.includes (\"timeout\") ||\n      error.includes (\"timed out\") ||\n      error.includes (\"connection\") ||\n      error.includes (\"temporarily unavailable\") ||\n      error.includes(\"eof\")\n  )\n  {\n        error_type = \"temporaray_service_error\";\n        retryable = true; \n      }else if (\n      error.includes(\"rate limit\") ||\n      error.includes (\"429\")\n     ){\n    error_type = \"rate limit\";\n      retryable = true;\n     } else if (\n        error.includes(\"500\") ||\n        error.includes(\"502\") ||\n        error.includes(\"503\") ||\n        error.includes(\"504\")\n  ){\n    error_type = \"service error\";\n    retryable = true;\n  }else if (\n  error.includes(\"authentication\") ||\n  error.includes(\"unauthorized\") ||\n  error.includes(\"api key\") ||\n  error.includes(\"credential\")\n  ){\n  error_type = \"authentication_error\";\n  retryable = false;\n  }else if (\n  error.includes(\"model\") && (\n  error.includes (\"not found\") ||\n  error.includes(\"does not exist\"))\n  ){\n  error_type = \"model_not_found\";\n  retryable = false;\n  }else {\n  error_type = \"unknown_ai_error\";\n  retryable = false;\n  }  \n  return {\n    json:{\n      ...item,\n      error_type,\n      retryable\n    }\n  }  \n});"
      },
