      "parameters": {
        "jsCode": "const cases = $input.all().map(item => item.json)\nconst customers_data = $('Generate Case ID & Idempotency Key').all().map( item => item.json)\nreturn cases.map(item => {\n  const customer= customers_data.find(customer => customer.case_id === item.case_id)\n  return {\n    json:{\n      customer_id : customer.customer_id,\n      case_id : customer.case_id,\n      customer_name : customer.customer_name,\n      customer_gmail : customer.customer_gmail,\n      customer_message : customer.customer_message\n    }\n  }\n});"
      },
