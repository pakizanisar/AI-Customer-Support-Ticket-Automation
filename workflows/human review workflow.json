        "jsCode": "const cases = $input.all().map(item => item.json)\nreturn cases.map(item =>\n  {\n    const error = (typeof item.error === \"string\"\n                   ? item.error\n                   : item.error?.message ||\n                   item.error?.description || \"\").toLowerCase()\n    let error_type\n    let retryable\n      if (error.includes(\"invalid email address\")){\n        error_type = \"invalid email\"\n        retryable = false;\n      }\n      else if (error.includes(\"rate limit\")){\n        error_type = \"rate limit\"\n        retryable = true;\n      }\n      else if (error.includes(\"timeout\")){\n        error_type = \"timeout\"\n        retryable = true;\n      }\n      else if (error.includes(\"service unavailable\")){\n        error_type = \"service unavailable\";\n        retryable = true;\n      }\n      else if (error.includes (\"needs to be reconnected\")){\n        error_type = 'credentail disconnected';\n        retryable = false;\n      }\n    else {\n      error_type = \"unknown\"\n      retryable = false;\n    }\n    return {\n      json:{\n        ...item,\n       error_type,\n       retryable\n      }\n    }\n    });"
      },
